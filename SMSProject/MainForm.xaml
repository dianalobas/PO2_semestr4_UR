<Window x:Class="SMSProject.MainForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMSProject"
        mc:Ignorable="d"
        Title="MainForm"
        Height="850"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F7FB">

    <Window.Resources>

        <!-- Styl przycisków podmenu -->
        <Style x:Key="SubMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF005BBB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
        </Style>

        <!-- Styl dla Expanderów menu bocznego -->
        <Style x:Key="MenuExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="6,4,6,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- 2 kolumny: lewe menu | prawa zawartość -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════ -->
        <!--          LEWE MENU            -->
        <!-- ══════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#FF0047A1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,10,0,10">

                    <!-- Logo i nazwa projektu -->
                    <StackPanel Margin="0,10,0,20"
                                HorizontalAlignment="Center">
                        <Image Height="100" Width="100" Source="/ur_logo_blue.jpg"/>
                        <TextBlock Text="SMS Project"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Panel główny"
                                   Foreground="#FFD9E6FF"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ── Sekcja Student ── -->
                    <Expander Header="Student"
                              Style="{StaticResource MenuExpanderStyle}"
                              IsExpanded="True">
                        <StackPanel>
                            <Button x:Name="btnRejestracja"
                                    Content="Rejestracja"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnZarzadzanieStudentami"
                                    Content="Zarządzanie studentami"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnDrukujStudenta"
                                    Content="Drukuj"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- ── Sekcja Kursy ── -->
                    <Expander Header="Kursy"
                              Style="{StaticResource MenuExpanderStyle}">
                        <StackPanel>
                            <Button x:Name="btnNowyKurs"
                                    Content="Nowy kurs"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnZarzadzajKursami"
                                    Content="Zarządzaj kursami"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnDrukujKursy"
                                    Content="Drukuj kursy"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- ── Sekcja Wyniki ── -->
                    <Expander Header="Wyniki"
                              Style="{StaticResource MenuExpanderStyle}">
                        <StackPanel>
                            <Button x:Name="btnNowyWynik"
                                    Content="Nowy wynik"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnZarzadzanieWynikami"
                                    Content="Zarządzanie wynikami"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnDrukujWyniki"
                                    Content="Drukuj wyniki"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- ── Sekcja Dashboard ── -->
                    <Expander Header="Dashboard"
                              Style="{StaticResource MenuExpanderStyle}">
                        <StackPanel>
                            <Button x:Name="btnDashboard"
                                    Content="Dashboard"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnRaporty"
                                    Content="Raporty"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                            <Button x:Name="btnStatystyki"
                                    Content="Statystyki"
                                    Style="{StaticResource SubMenuButtonStyle}"
                                    Click="MenuButton_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- Przycisk Wyjście -->
                    <Button x:Name="btnWyjscie"
                            Content="Wyjście"
                            Margin="10,25,10,10"
                            Height="36"
                            Background="#FFCC0000"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnWyjscie_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════ -->
        <!--         PRAWA CZĘŚĆ           -->
        <!-- ══════════════════════════════ -->
        <Grid Grid.Column="1" Margin="15">
            <!-- 3 wiersze: nagłówek | obszar główny | panel dolny -->
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <!-- ── GÓRNY PANEL (nagłówek) ── -->
            <Border Grid.Row="0"
                    Background="White"
                    Padding="22">
                <Grid Margin="0,0,0,-12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tekst: uczelnia, użytkownik, rola -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Uniwersytet Rzeszowski"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#FF0047A1"
                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="Witaj:"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#FF1F2D3D"/>
                            <TextBlock x:Name="welcomeUserText"
                                       Text="Administrator"
                                       FontSize="18"
                                       Foreground="#FF1F2D3D"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Rola:"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#FF1F2D3D"/>
                            <TextBlock x:Name="roleText"
                                       Text="Administrator systemu"
                                       FontSize="18"
                                       Foreground="#FF1F2D3D"
                                       Margin="8,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ikona użytkownika -->
                    <Border Grid.Column="1"
                            Width="100"
                            Height="100"
                            Background="#FFEAF1FB"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="👤"
                                   FontSize="46"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── ŚRODKOWY PANEL (obszar roboczy) ── -->
            <Border Grid.Row="1"
                    Background="White"
                    Padding="15"
                    Margin="0,10,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="13*"/>
                        <ColumnDefinition Width="27*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tytuł aktywnej sekcji -->
                    <TextBlock x:Name="sectionTitleText"
                               Text="Panel główny"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FF0047A1"
                               VerticalAlignment="Center" Grid.ColumnSpan="2"/>

                    <!-- Pusty obszar roboczy contentArea -->
                    <Border Grid.Row="1"
                            Background="#FFF7F9FC"
                            BorderBrush="#FFD8E1F0"
                            BorderThickness="1"
                            Padding="10" Grid.ColumnSpan="2">
                        <Grid x:Name="contentArea"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── DOLNY PANEL (statystyki) ── -->
            <Border Grid.Row="2"
                    Background="#FF0047A1"
                    Padding="22">
                <Grid>
                    <!-- 3 kolumny: liczba studentów | wybór grupy | statystyki -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lewa: łączna liczba studentów -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Łączna liczba studentów:"
                                   FontSize="18"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Mężczyźni:"
                                       Foreground="White"
                                       FontSize="16"/>
                            <TextBlock x:Name="maleCountText"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="8,0,24,0"/>
                            <TextBlock Text="Kobiety:"
                                       Foreground="White"
                                       FontSize="16"/>
                            <TextBlock x:Name="femaleCountText"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Środkowa: wybór grupy -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="25,0,25,0">
                        <TextBlock Text="Wybierz grupę:"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <ComboBox x:Name="classComboBox"
                                  Height="34"
                                  FontSize="15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="INF BS2 Lab 1"/>
                            <ComboBoxItem Content="INF BS2 Lab 2"/>
                            <ComboBoxItem Content="INF PO Lab 1"/>
                            <ComboBoxItem Content="INF PO Lab 2"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Prawa: statystyki grupy -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="Statystyki"
                                   FontSize="18"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Mężczyźni:"
                                       Foreground="White"
                                       FontSize="16"/>
                            <TextBlock Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="8,0,20,0"/>
                            <TextBlock Text="Kobiety:"
                                       Foreground="White"
                                       FontSize="16"/>
                            <TextBlock Text="0"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
