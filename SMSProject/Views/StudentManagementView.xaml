<UserControl x:Class="SMSProject.Views.StudentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF7F9FC">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0" Text="Zarządzanie studentami"
                   FontSize="18" FontWeight="Bold" Foreground="#FF0047A1"/>

        <!-- Pasek filtrów -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox  Grid.Column="0" x:Name="searchTextBox"       Height="30" FontSize="13" Padding="5,4"
                      Text="" ToolTip="Szukaj po imieniu, nazwisku lub nr albumu"/>
            <ComboBox Grid.Column="2" x:Name="filterGroupComboBox" Height="30" FontSize="13">
                <ComboBoxItem Content="Wszystkie grupy" IsSelected="True"/>
                <ComboBoxItem Content="Grupa 1"/>
                <ComboBoxItem Content="Grupa 2"/>
                <ComboBoxItem Content="Grupa 3"/>
                <ComboBoxItem Content="Grupa 4"/>
            </ComboBox>
            <ComboBox Grid.Column="4" x:Name="filterGenderComboBox" Height="30" FontSize="13">
                <ComboBoxItem Content="Wszyscy" IsSelected="True"/>
                <ComboBoxItem Content="Mężczyzna"/>
                <ComboBoxItem Content="Kobieta"/>
            </ComboBox>
            <Button Grid.Column="6" x:Name="searchStudentButton" Content="Szukaj" Width="90" Height="30"
                    Background="#FF0047A1" Foreground="White" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="searchStudentButton_Click"/>
            <Button Grid.Column="8" x:Name="refreshStudentButton" Content="Odśwież" Width="90" Height="30"
                    Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="refreshStudentButton_Click"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="4" x:Name="studentsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowBackground="White"
                  AlternatingRowBackground="#FFF0F4FB"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding StudentId}"   Width="55"/>
                <DataGridTextColumn Header="Imię"       Binding="{Binding FirstName}"   Width="130"/>
                <DataGridTextColumn Header="Nazwisko"   Binding="{Binding LastName}"    Width="130"/>
                <DataGridTextColumn Header="Nr albumu"  Binding="{Binding AlbumNumber}" Width="110"/>
                <DataGridTextColumn Header="Email"      Binding="{Binding Email}"       Width="*"/>
                <DataGridTextColumn Header="Płeć"       Binding="{Binding Gender}"      Width="90"/>
                <DataGridTextColumn Header="Grupa"      Binding="{Binding GroupId}"     Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Przyciski dolne -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="detailsStudentButton" Content="Szczegóły" Width="100" Height="32" Margin="0,0,8,0"
                    Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="detailsStudentButton_Click"/>
            <Button x:Name="editStudentButton"    Content="Edytuj"    Width="90"  Height="32" Margin="0,0,8,0"
                    Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="editStudentButton_Click"/>
            <Button x:Name="deleteStudentButton"  Content="Usuń"      Width="90"  Height="32"
                    Background="#FFCC0000" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="deleteStudentButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
