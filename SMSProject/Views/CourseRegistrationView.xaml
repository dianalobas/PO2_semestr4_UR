<UserControl x:Class="SMSProject.Views.CourseRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF7F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <TextBlock Text="Nowy kurs"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#FF0047A1" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa kursu:"  VerticalAlignment="Center" FontSize="14"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="courseNameTextBox" Height="30" FontSize="14" Padding="5,4"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="ECTS:"         VerticalAlignment="Center" FontSize="14" Margin="12,0,0,0"/>
                <ComboBox  Grid.Row="0" Grid.Column="3" x:Name="ectsComboBox" Height="30" FontSize="14">
                    <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Semestr:"      VerticalAlignment="Center" FontSize="14"/>
                <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="semesterComboBox" Height="30" FontSize="14">
                    <ComboBoxItem Content="Semestr 1"/><ComboBoxItem Content="Semestr 2"/>
                    <ComboBoxItem Content="Semestr 3"/><ComboBoxItem Content="Semestr 4"/>
                    <ComboBoxItem Content="Semestr 5"/><ComboBoxItem Content="Semestr 6"/>
                    <ComboBoxItem Content="Semestr 7"/><ComboBoxItem Content="Semestr 8"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Prowadzący:"   VerticalAlignment="Center" FontSize="14" Margin="12,0,0,0"/>
                <TextBox   Grid.Row="2" Grid.Column="3" x:Name="lecturerTextBox" Height="30" FontSize="14" Padding="5,4"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="clearCourseButton"  Content="Wyczyść" Width="90" Height="32" Margin="0,0,8,0"
                        Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                        Click="clearCourseButton_Click"/>
                <Button x:Name="cancelCourseButton" Content="Anuluj"  Width="90" Height="32" Margin="0,0,8,0"
                        Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                        Click="cancelCourseButton_Click"/>
                <Button x:Name="saveCourseButton"   Content="Zapisz"  Width="100" Height="32"
                        Background="#FF0047A1" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="saveCourseButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
