<UserControl x:Class="SMSProject.Views.CourseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF7F9FC">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Zarządzanie kursami"
                   FontSize="18" FontWeight="Bold" Foreground="#FF0047A1"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox  Grid.Column="0" x:Name="searchCourseTextBox" Height="30" FontSize="13" Padding="5,4"
                      ToolTip="Szukaj po nazwie kursu"/>
            <ComboBox Grid.Column="2" x:Name="filterSemesterComboBox" Height="30" FontSize="13">
                <ComboBoxItem Content="Wszystkie semestry" IsSelected="True"/>
                <ComboBoxItem Content="Semestr 1"/><ComboBoxItem Content="Semestr 2"/>
                <ComboBoxItem Content="Semestr 3"/><ComboBoxItem Content="Semestr 4"/>
                <ComboBoxItem Content="Semestr 5"/><ComboBoxItem Content="Semestr 6"/>
                <ComboBoxItem Content="Semestr 7"/><ComboBoxItem Content="Semestr 8"/>
            </ComboBox>
            <Button Grid.Column="4" Content="Szukaj"  Width="90" Height="30"
                    Background="#FF0047A1" Foreground="White" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="searchCourseButton_Click"/>
            <Button Grid.Column="6" x:Name="refreshCourseButton" Content="Odśwież" Width="90" Height="30"
                    Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="refreshCourseButton_Click"/>
        </Grid>

        <DataGrid Grid.Row="4" x:Name="coursesDataGrid"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowBackground="White" AlternatingRowBackground="#FFF0F4FB" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding CourseId}"   Width="55"/>
                <DataGridTextColumn Header="Nazwa kursu" Binding="{Binding CourseName}" Width="*"/>
                <DataGridTextColumn Header="ECTS"       Binding="{Binding Ects}"        Width="60"/>
                <DataGridTextColumn Header="Semestr"    Binding="{Binding Semester}"    Width="110"/>
                <DataGridTextColumn Header="Prowadzący" Binding="{Binding Lecturer}"    Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="detailsCourseButton" Content="Szczegóły" Width="100" Height="32" Margin="0,0,8,0"
                    Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="detailsCourseButton_Click"/>
            <Button x:Name="editCourseButton"    Content="Edytuj"    Width="90"  Height="32" Margin="0,0,8,0"
                    Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="editCourseButton_Click"/>
            <Button x:Name="deleteCourseButton"  Content="Usuń"      Width="90"  Height="32"
                    Background="#FFCC0000" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="deleteCourseButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
