<UserControl x:Class="SMSProject.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF7F9FC">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Statystyki"
                   FontSize="18" FontWeight="Bold" Foreground="#FF0047A1"/>

        <!-- Filtry -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="filterGroupStats" Height="30" FontSize="13">
                <ComboBoxItem Content="Wszystkie grupy" IsSelected="True"/>
                <ComboBoxItem Content="Grupa 1"/><ComboBoxItem Content="Grupa 2"/>
                <ComboBoxItem Content="Grupa 3"/><ComboBoxItem Content="Grupa 4"/>
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="filterCourseStats" Height="30" FontSize="13">
                <ComboBoxItem Content="Wszystkie kursy" IsSelected="True"/>
            </ComboBox>
            <ComboBox Grid.Column="4" x:Name="filterSemesterStats" Height="30" FontSize="13">
                <ComboBoxItem Content="Wszystkie semestry" IsSelected="True"/>
                <ComboBoxItem Content="Semestr 1"/><ComboBoxItem Content="Semestr 2"/>
                <ComboBoxItem Content="Semestr 3"/><ComboBoxItem Content="Semestr 4"/>
            </ComboBox>
            <Button Grid.Column="6" x:Name="calcButton" Content="Oblicz" Width="90" Height="30"
                    Background="#FF0047A1" Foreground="White" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="calcButton_Click"/>
            <Button Grid.Column="8" x:Name="clearStatsButton" Content="Wyczyść" Width="90" Height="30"
                    Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Click="clearStatsButton_Click"/>
        </Grid>

        <!-- Kafelki liczb -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" Padding="14" BorderBrush="#FFD8E1F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Liczba studentów" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="statsStudentCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF0047A1"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" Padding="14" BorderBrush="#FFD8E1F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Liczba kursów" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="statsCourseCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF0047A1"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" Padding="14" BorderBrush="#FFD8E1F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Średnia ocen" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="statsAvgGrade" Text="0.00" FontSize="28" FontWeight="Bold" Foreground="#FF0047A1"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Background="White" Padding="14" BorderBrush="#FFD8E1F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Liczba wyników" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="statsResultCount" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF0047A1"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Zestawienie -->
        <Border Grid.Row="6" Background="White" Padding="12" BorderBrush="#FFD8E1F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Zestawienie statystyczne" FontSize="14" FontWeight="SemiBold"
                           Foreground="#FF0047A1" Margin="0,0,0,8"/>
                <TextBlock x:Name="statsDetailText" Text="Kliknij 'Oblicz' aby zobaczyć zestawienie."
                           FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
