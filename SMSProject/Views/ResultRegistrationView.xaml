<UserControl x:Class="SMSProject.Views.ResultRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF7F9FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <TextBlock Text="Nowy wynik"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#FF0047A1" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Student:"    VerticalAlignment="Center" FontSize="14"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="studentComboBox"   Height="30" FontSize="14" DisplayMemberPath="FullName"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Kurs:"       VerticalAlignment="Center" FontSize="14" Margin="12,0,0,0"/>
                <ComboBox  Grid.Row="0" Grid.Column="3" x:Name="courseComboBox"    Height="30" FontSize="14" DisplayMemberPath="CourseName"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ocena:"      VerticalAlignment="Center" FontSize="14"/>
                <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="gradeComboBox"     Height="30" FontSize="14">
                    <ComboBoxItem Content="2.0"/><ComboBoxItem Content="3.0"/>
                    <ComboBoxItem Content="3.5"/><ComboBoxItem Content="4.0"/>
                    <ComboBoxItem Content="4.5"/><ComboBoxItem Content="5.0"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Data:"       VerticalAlignment="Center" FontSize="14" Margin="12,0,0,0"/>
                <DatePicker Grid.Row="2" Grid.Column="3" x:Name="dateAddedPicker"  Height="30" FontSize="14"
                            SelectedDate="{x:Static sys:DateTime.Today}"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="clearResultButton"  Content="Wyczyść" Width="90" Height="32" Margin="0,0,8,0"
                        Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                        Click="clearResultButton_Click"/>
                <Button x:Name="cancelResultButton" Content="Anuluj"  Width="90" Height="32" Margin="0,0,8,0"
                        Background="#FFD0D8E8" Foreground="#FF1F2D3D" FontSize="13" BorderThickness="0" Cursor="Hand"
                        Click="cancelResultButton_Click"/>
                <Button x:Name="saveResultButton"   Content="Zapisz"  Width="100" Height="32"
                        Background="#FF0047A1" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="saveResultButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
