<Window x:Class="SMSProject.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login SMS"
        Height="500"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek z logo i nazwą uczelni -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0">

            <!-- Logo uczelni (zastępcze - niebieski kwadrat z "UR") -->

            <Image Height="100" Width="100" Source="/ur_logo_blue.jpg"/>

            <TextBlock Text="Uniwersytet Rzeszowski"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FF0047A1"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Formularz logowania -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="220">

            <TextBlock Text="Login:"
                       FontSize="14"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="userName"
                     Height="30"
                     FontSize="14"
                     Margin="0,0,0,14"
                     Padding="6,4"/>

            <TextBlock Text="Hasło:"
                       FontSize="14"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="password"
                         Height="30"
                         FontSize="14"
                         Margin="0,0,0,22"
                         Padding="6,4"/>

            <Button x:Name="btnLogin"
                    Content="Zaloguj"
                    Height="36"
                    Background="#FF0047A1"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
